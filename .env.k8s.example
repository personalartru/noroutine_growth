# Шаблон секретов для кластера. Скопируйте в .env.k8s, заполните и
# выполните: bash deploy/k8s/sync-secrets.sh
#
# Токены ботов берутся из BotFather и из настроек бота в MAX
# (платформа MAX для партнёров -> Чат-боты -> ваш бот -> Настройки).

# Telegram-бот лид-магнита (@noroutine_ai_bot)
TELEGRAM_BOT_TOKEN=
LEAD_CHANNEL_USERNAME=@noroutine2026
LEAD_ADMIN_CHAT_ID=270479866

# MAX-бот (@noroutine_bot) — администратор канала max.ru/channel_noroutine
MAX_BOT_TOKEN=
MAX_ADMIN_CHAT_ID=60669315
MAX_PING_CHAT_ID=485434975
