            {
              "name": "Authorization",
              "value": "=Bearer {{$env.TRACKER_TOKEN}}"
            },
            {
              "name": "X-Tracker-Org-Id",
              "value": "={{$env.TRACKER_ORG_ID}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { summary: $json.summary, description: $json.description, project: { id: $json.project }, type: { id: '3' } } }) }}",
