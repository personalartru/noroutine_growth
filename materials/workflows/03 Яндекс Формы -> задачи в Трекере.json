    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body || {};\nconst answers = body.answers || [];\nconst get = (code) => {\n  const a = answers.find((x) => String(x.code).includes(code));\n  return a ? (a.text || a.value || '') : '';\n};\nconst title = get('question_title') || body.title || 'Заявка из формы';\nconst description = answers.map((a) => `${a.question || a.code}: ${a.text || a.value || ''}`).join('\\n');\nreturn [{ json: { summary: title, description, email: body.email || '', project: body.project || 'TMP' } }];"
      },
      "id": "n0002разо",
      "name": "Разобрать ответы",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
