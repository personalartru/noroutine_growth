{
  "name": "06 Telegram-бот обратной связи -> Google Sheets",
  "core": true,
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "n0001tele",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const text = $json.message ? $json.message.text : ($json.text || '');\nconst chat = $json.message ? $json.message.chat : $json.chat;\nconst from = $json.message ? $json.message.from : $json.from;\nreturn [{ json: {\n  text: text,\n  chatId: chat ? chat.id : null,\n  name: from ? (from.first_name || '') : '',\n  username: from ? (from.username || '') : '',\n  created: new Date().toISOString(),\n} }];"
      },
      "id": "n0002разо",
      "name": "Разобрать сообщение",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.text.length }}",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n0003вали",
      "name": "Валидация",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "documentId": "={{ $env.SHEETS_ID }}",
        "sheetName": "Заявки",
        "operation": "append",
        "columns": "={{ ['created','name','username','text'] }}"
      },
      "id": "n0004запи",
      "name": "Записать заявку",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=Принял, спасибо! Отвечу в рабочее время.",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "n0005отве",
      "name": "Ответить в чат",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=Пришлите текст заявки — запишу её.",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "n0006отве",
      "name": "Ответить «пусто»",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        120
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Разобрать сообщение",
